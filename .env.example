# ShopAssistantRAG — environment configuration
# Copy to .env and fill in real values. .env is gitignored and never committed.
#
#   cp .env.example .env
#
# Three external services are used:
#   - Google Gemini  -> EMBEDDINGS only (text -> 768-dim vectors)
#   - Groq           -> CHAT GENERATION + filter extraction (the LLM)
#   - Pinecone       -> vector storage / semantic search
# MySQL stores the product catalog (runs locally or in the Docker stack).

# --- Secrets (required) ---
# Google Gemini API key — used for EMBEDDINGS only. Get one at:
#   https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Groq API key — used for CHAT GENERATION + filter extraction. Get one at:
#   https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Pinecone API key — vector index storage/search. Get one at:
#   https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here

# --- MySQL connection (required) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=shop_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=shopassistant

# --- LLM generation provider (filter extraction + answer generation) ---
# Which LLM powers generation: 'groq' (default) or 'gemini' (legacy fallback).
# Embeddings ALWAYS use Gemini regardless of this setting.
LLM_PROVIDER=groq
# Groq chat model — used when LLM_PROVIDER=groq.
GROQ_MODEL=llama-3.3-70b-versatile
# Legacy Gemini generation model — used ONLY when LLM_PROVIDER=gemini.
GENERATION_MODEL=gemini-1.5-flash

# --- Embeddings & vector index ---
# Gemini embedding model. Must yield EMBEDDING_DIM dimensions; the embedding
# client requests output_dimensionality=EMBEDDING_DIM so the vector matches the
# Pinecone index. The Pinecone index dimension MUST equal EMBEDDING_DIM (768).
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
PINECONE_INDEX_NAME=shop-products

# --- API / logging (optional; defaults shown) ---
# Comma-separated CORS origins allowed by the backend (the Streamlit origin).
ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO
